; ============================================================
;  FILE KONFIGURASI DATABASE — OJS Publikasi
;  Nawa Edukasi Nusantara
; ============================================================
;
;  CARA PENGGUNAAN:
;  1. Salin file ini menjadi ".env"  (hilangkan kata "example")
;     Perintah: cp .env.example .env
;
;  2. Isi setiap nilai di bawah sesuai konfigurasi database
;     MySQL / MariaDB milik kamu.
;
;  3. JANGAN pernah commit file ".env" ke Git!
;     File ini sudah ada di .gitignore.
;
; ============================================================


; ------------------------------------------------------------
;  JENIS KONEKSI DATABASE
;  Saat ini hanya mendukung: mysql
;  Jangan diubah kecuali kamu tahu apa yang kamu lakukan.
; ------------------------------------------------------------
DB_CONNECTION="mysql"


; ------------------------------------------------------------
;  HOST DATABASE
;  - Jika database ada di komputer yang SAMA (localhost):
;    gunakan "127.0.0.1" atau "localhost"
;  - Jika database ada di server lain (hosting/VPS):
;    isi dengan IP atau domain server tersebut
;    Contoh: "db.example.com" atau "192.168.1.10"
; ------------------------------------------------------------
DB_HOST="127.0.0.1"


; ------------------------------------------------------------
;  PORT DATABASE
;  - MySQL default: 3306
;  - Ubah hanya jika server kamu menggunakan port berbeda
;    (misalnya XAMPP bawaan tetap 3306, Laragon kadang 3307)
; ------------------------------------------------------------
DB_PORT="3306"


; ------------------------------------------------------------
;  NAMA DATABASE
;  - Buat dulu database-nya di phpMyAdmin / MySQL sebelum
;    menjalankan aplikasi ini.
;  - Contoh perintah SQL:
;    CREATE DATABASE ojs_publikasi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
; ------------------------------------------------------------
DB_DATABASE="nama_database_kamu"


; ------------------------------------------------------------
;  USERNAME DATABASE
;  - Username MySQL yang punya akses ke database di atas.
;  - Di XAMPP/Laragon biasanya: "root"
;  - Di hosting biasanya berbeda, cek di cPanel / Plesk.
; ------------------------------------------------------------
DB_USERNAME="root"


; ------------------------------------------------------------
;  PASSWORD DATABASE
;  - Password untuk username di atas.
;  - Di XAMPP default: kosong (isi "")
;  - Di Laragon default: kosong (isi "")
;  - Di hosting / VPS: sesuai password yang kamu buat
; ------------------------------------------------------------
DB_PASSWORD=""


; ============================================================
;  CONTOH KONFIGURASI UMUM:
;
;  [XAMPP / Laragon — lokal]
;    DB_HOST="127.0.0.1"
;    DB_PORT="3306"
;    DB_DATABASE="ojs_publikasi"
;    DB_USERNAME="root"
;    DB_PASSWORD=""
;
;  [Hosting cPanel]
;    DB_HOST="localhost"
;    DB_PORT="3306"
;    DB_DATABASE="namauser_ojs"
;    DB_USERNAME="namauser_dbuser"
;    DB_PASSWORD="passwordDariCpanel"
;
;  [VPS / Server Terpisah]
;    DB_HOST="192.168.1.100"
;    DB_PORT="3306"
;    DB_DATABASE="ojs_publikasi"
;    DB_USERNAME="ojs_user"
;    DB_PASSWORD="passwordKamu"
; ============================================================


; ============================================================
;  AKUN ADMIN DEFAULT
;  Gunakan kredensial ini untuk login ke halaman admin:
;  URL Login: /login-secure-xyz.php
;
;  Email   : (sesuai yang didaftarkan di tabel users)
;  Password: (sesuai yang didaftarkan di tabel users)
;
;  Jika perlu membuat akun baru, jalankan query SQL ini:
;
;  INSERT INTO users (username, email, password) VALUES (
;    'nama_admin',
;    'admin@email.com',
;    -- Generate hash password dengan PHP:
;    -- php -r "echo password_hash('passwordkamu', PASSWORD_DEFAULT);"
;    '$2y$12$hash_hasil_generate_di_atas'
;  );
; ============================================================

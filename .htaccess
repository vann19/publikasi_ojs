RewriteEngine On
Options -MultiViews

# ── Force HTTPS (redirect http → https) ──
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Force non-www (redirect www.nawaedukasi.org → nawaedukasi.org) ──
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# ── Redirect /index.php ke / (menghilangkan duplikat beranda) ──
RewriteCond %{THE_REQUEST} \s/index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# ── Sitemap: redirect /sitemap.xml ke /sitemap.php ──
RewriteRule ^sitemap\.xml$ /sitemap.php [L]

# Redirect /buku to /books
RewriteRule ^buku/(.*)$ books/$1 [R=301,L]

# Rewrite books/slug to books/detail.php?slug=slug
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^books/([^/]+)/?$ books/detail.php?slug=$1 [L,QSA]
